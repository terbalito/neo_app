<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Neo-Brutal Posts</title>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/header') %>

  <h1>Posts anonymes</h1>

  <form id="postForm">
    <textarea name="contenu" placeholder="Écris ton post..." required></textarea>
    <button type="submit">Poster</button>
  </form>

  <div id="posts" class="posts"></div>

  <%- include('partials/footer') %>

  <!-- Définir l'URL du backend -->
  <script>
    const BACKEND_URL = '<%= process.env.BACKEND_URL || "http://localhost:3001" %>';

    const form = document.getElementById('postForm');

    async function chargerPosts() {
      try {
        const res = await fetch(`${BACKEND_URL}/api/posts`);
        const posts = await res.json();
        const container = document.getElementById('posts');
        container.innerHTML = posts.map(p => `
          <div class="post">
            <p>${p.contenu}</p>
            <span>${new Date(p.date).toLocaleString()}</span>
          </div>
        `).join('');
      } catch (err) {
        console.error('Erreur récupération posts:', err);
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const contenu = form.contenu.value.trim();
      if (!contenu) return;

      try {
        await fetch(`${BACKEND_URL}/api/posts`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contenu })
        });
        form.reset();
        chargerPosts();
      } catch (err) {
        console.error('Erreur lors de l’envoi du post:', err);
      }
    });

    chargerPosts();
  </script>
</body>
</html>
